# glg3d contains C++ sources and zlib C sources. Keep the regular compiler for
# anything outside zlib so this launcher cannot change another vendor library.
set(arguments)
set(after_separator FALSE)
set(compiler "")
foreach(index RANGE 0 ${CMAKE_ARGC})
  if (after_separator)
    if (compiler STREQUAL "")
      set(compiler "${CMAKE_ARGV${index}}")
    elseif(index LESS CMAKE_ARGC)
      list(APPEND arguments "${CMAKE_ARGV${index}}")
    endif()
  elseif(CMAKE_ARGV${index} STREQUAL "--")
    set(after_separator TRUE)
  endif()
endforeach()
if (compiler STREQUAL "")
  message(FATAL_ERROR "The MSVC RTM launcher needs a compiler command after --")
endif()

file(REAL_PATH "${OPENRBX_ZLIB_SOURCE_DIR}" zlib_directory)
string(TOLOWER "${zlib_directory}/" zlib_prefix)
# NMake passes the entire compile command in a response file. Inspect its
# contents for the source guard while forwarding the original file unchanged.
set(inspect_arguments ${arguments})
foreach(argument IN LISTS arguments)
  if (argument MATCHES "^@(.+)$")
    set(response_file "${CMAKE_MATCH_1}")
    if (EXISTS "${response_file}")
      file(READ "${response_file}" response)
      separate_arguments(response_arguments WINDOWS_COMMAND "${response}")
      list(APPEND inspect_arguments ${response_arguments})
    endif()
  endif()
endforeach()
foreach(argument IN LISTS inspect_arguments)
  if (argument MATCHES "\\.[cC]$" AND EXISTS "${argument}")
    file(REAL_PATH "${argument}" source)
    string(TOLOWER "${source}" source)
    string(FIND "${source}" "${zlib_prefix}" prefix_position)
    if (prefix_position EQUAL 0)
      set(compiler "${OPENRBX_MSVC_RTM_COMPILER}")
      break()
    endif()
  endif()
endforeach()

# Keep /Zi: it does not change these objects' code, and it retains private
# helper symbols needed to compare them with the original no-debug library.
execute_process(COMMAND "${compiler}" ${arguments} RESULT_VARIABLE result)
if (NOT result STREQUAL "0")
  message(FATAL_ERROR "MSVC compilation failed (${result})")
endif()
